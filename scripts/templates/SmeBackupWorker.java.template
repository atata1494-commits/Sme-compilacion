package __PACKAGE__;

import android.content.ContentResolver;
import android.content.ContentValues;
import android.content.Context;
import android.database.Cursor;
import android.database.sqlite.SQLiteDatabase;
import android.net.Uri;
import android.os.Build;
import android.os.Environment;
import android.provider.MediaStore;

import androidx.annotation.NonNull;
import androidx.work.Worker;
import androidx.work.WorkerParameters;

import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.InputStream;
import java.io.OutputStream;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Locale;
import java.util.UUID;

public final class SmeBackupWorker extends Worker {
    private static final String DAILY_PREFIX = "SME-auto-diario-";
    private static final String MONTHLY_PREFIX = "SME-historico-mensual-";
    private static final String RELATIVE_FOLDER = Environment.DIRECTORY_DOCUMENTS + "/SME/Respaldos";

    public SmeBackupWorker(@NonNull Context context, @NonNull WorkerParameters params) {
        super(context, params);
    }

    @NonNull
    @Override
    public Result doWork() {
        File source = getApplicationContext().getDatabasePath("sme_tallerSQLite.db");
        if (!source.isFile() || source.length() == 0) return Result.retry();

        File temporary = new File(getApplicationContext().getCacheDir(), "sme-backup-" + UUID.randomUUID() + ".db");
        SQLiteDatabase sourceDb = null;
        try {
            sourceDb = SQLiteDatabase.openDatabase(source.getAbsolutePath(), null, SQLiteDatabase.OPEN_READWRITE);
            String version = scalar(sourceDb, "SELECT sqlite_version()");
            if (!supportsVacuumInto(version)) {
                throw new IllegalStateException("SQLite del dispositivo no admite VACUUM INTO; no se generó una copia potencialmente inconsistente.");
            }
            String safePath = temporary.getAbsolutePath().replace("'", "''");
            sourceDb.execSQL("VACUUM INTO '" + safePath + "'");
            sourceDb.close();
            sourceDb = null;

            validateSnapshot(temporary);
            String day = new java.text.SimpleDateFormat("yyyy-MM-dd", Locale.ROOT).format(new java.util.Date());
            String month = new java.text.SimpleDateFormat("yyyy-MM", Locale.ROOT).format(new java.util.Date());
            publishIfMissing(temporary, DAILY_PREFIX + day + ".db");
            publishIfMissing(temporary, MONTHLY_PREFIX + month + ".db");
            prune(DAILY_PREFIX, 7);
            prune(MONTHLY_PREFIX, 60);
            return Result.success();
        } catch (Exception error) {
            android.util.Log.e("SMEBackup", "No se pudo crear o validar el respaldo SQLite", error);
            return Result.retry();
        } finally {
            if (sourceDb != null) {
                try { sourceDb.close(); } catch (Exception ignored) {}
            }
            if (temporary.exists() && !temporary.delete()) {
                android.util.Log.w("SMEBackup", "No se pudo eliminar la copia temporal: " + temporary.getAbsolutePath());
            }
        }
    }

    private static String scalar(SQLiteDatabase db, String sql) {
        try (Cursor cursor = db.rawQuery(sql, null)) {
            if (!cursor.moveToFirst()) throw new IllegalStateException("La consulta no devolvió resultado.");
            return cursor.getString(0);
        }
    }

    private static boolean supportsVacuumInto(String version) {
        try {
            String[] parts = version.split("\\.");
            int major = Integer.parseInt(parts[0]);
            int minor = Integer.parseInt(parts[1]);
            int patch = parts.length > 2 ? Integer.parseInt(parts[2].replaceAll("[^0-9].*$", "")) : 0;
            return major > 3 || (major == 3 && (minor > 27 || (minor == 27 && patch >= 0)));
        } catch (Exception ignored) {
            return false;
        }
    }

    private void validateSnapshot(File file) {
        if (!file.isFile() || file.length() < 1024) throw new IllegalStateException("El archivo SQLite de respaldo está vacío o incompleto.");
        try (SQLiteDatabase db = SQLiteDatabase.openDatabase(file.getAbsolutePath(), null, SQLiteDatabase.OPEN_READONLY)) {
            String integrity = scalar(db, "PRAGMA integrity_check");
            if (!"ok".equalsIgnoreCase(integrity)) throw new IllegalStateException("Falló PRAGMA integrity_check: " + integrity);
            try (Cursor tables = db.rawQuery("SELECT name FROM sqlite_master WHERE type='table'", null)) {
                List<String> names = new ArrayList<>();
                while (tables.moveToNext()) names.add(tables.getString(0));
                for (String required : new String[]{"clientes", "vehiculos", "trabajos", "adjuntos", "pagos_cuenta", "sme_tareas", "sme_avisos", "sme_solicitudes_gasto", "sme_auditoria", "sme_tarea_eventos", "sme_aviso_derivaciones", "cambios_sync", "cambios_recibidos", "paquetes_intercambio", "conflictos_sync"}) {
                    if (!names.contains(required)) throw new IllegalStateException("Falta la tabla requerida en el respaldo: " + required);
                }
            }
        }
    }

    private void publishIfMissing(File snapshot, String name) throws Exception {
        if (Build.VERSION.SDK_INT >= 29) {
            ContentResolver resolver = getApplicationContext().getContentResolver();
            Uri collection = MediaStore.Files.getContentUri("external");
            try (Cursor existing = resolver.query(collection, new String[]{MediaStore.MediaColumns._ID},
                    MediaStore.MediaColumns.RELATIVE_PATH + "=? AND " + MediaStore.MediaColumns.DISPLAY_NAME + "=?",
                    new String[]{RELATIVE_FOLDER + "/", name}, null)) {
                if (existing != null && existing.moveToFirst()) return;
            }
            ContentValues values = new ContentValues();
            values.put(MediaStore.MediaColumns.DISPLAY_NAME, name);
            values.put(MediaStore.MediaColumns.MIME_TYPE, "application/vnd.sqlite3");
            values.put(MediaStore.MediaColumns.RELATIVE_PATH, RELATIVE_FOLDER);
            values.put(MediaStore.MediaColumns.IS_PENDING, 1);
            Uri destination = resolver.insert(collection, values);
            if (destination == null) throw new IllegalStateException("Android no permitió crear el archivo de respaldo en Documentos.");
            boolean completed = false;
            try (InputStream input = new FileInputStream(snapshot);
                 OutputStream output = resolver.openOutputStream(destination, "w")) {
                if (output == null) throw new IllegalStateException("No se pudo abrir el archivo de destino.");
                copy(input, output);
                output.flush();
                ContentValues ready = new ContentValues();
                ready.put(MediaStore.MediaColumns.IS_PENDING, 0);
                resolver.update(destination, ready, null, null);
                completed = true;
            } finally {
                if (!completed) resolver.delete(destination, null, null);
            }
        } else {
            File base = getApplicationContext().getExternalFilesDir(Environment.DIRECTORY_DOCUMENTS);
            if (base == null) throw new IllegalStateException("No está disponible el almacenamiento externo de la aplicación.");
            File directory = new File(base, "SME/Respaldos");
            if (!directory.exists() && !directory.mkdirs()) throw new IllegalStateException("No se pudo crear la carpeta de respaldos.");
            File destination = new File(directory, name);
            if (destination.exists()) return;
            try (InputStream input = new FileInputStream(snapshot); OutputStream output = new FileOutputStream(destination)) {
                copy(input, output);
            }
        }
    }

    private static void copy(InputStream input, OutputStream output) throws Exception {
        byte[] buffer = new byte[64 * 1024];
        int count;
        while ((count = input.read(buffer)) != -1) output.write(buffer, 0, count);
    }

    private void prune(String prefix, int keep) {
        try {
            if (Build.VERSION.SDK_INT >= 29) {
                ContentResolver resolver = getApplicationContext().getContentResolver();
                Uri collection = MediaStore.Files.getContentUri("external");
                List<String> names = new ArrayList<>();
                List<Uri> uris = new ArrayList<>();
                try (Cursor cursor = resolver.query(collection,
                        new String[]{MediaStore.MediaColumns._ID, MediaStore.MediaColumns.DISPLAY_NAME},
                        MediaStore.MediaColumns.RELATIVE_PATH + "=? AND " + MediaStore.MediaColumns.DISPLAY_NAME + " LIKE ?",
                        new String[]{RELATIVE_FOLDER + "/", prefix + "%.db"}, null)) {
                    if (cursor != null) while (cursor.moveToNext()) {
                        String name = cursor.getString(1);
                        if (name != null && name.startsWith(prefix) && name.endsWith(".db")) {
                            names.add(name);
                            uris.add(Uri.withAppendedPath(collection, cursor.getString(0)));
                        }
                    }
                }
                List<Integer> order = new ArrayList<>();
                for (int i = 0; i < names.size(); i++) order.add(i);
                Collections.sort(order, (a, b) -> names.get(b).compareTo(names.get(a)));
                for (int i = keep; i < order.size(); i++) resolver.delete(uris.get(order.get(i)), null, null);
            } else {
                File base = getApplicationContext().getExternalFilesDir(Environment.DIRECTORY_DOCUMENTS);
                File directory = base == null ? null : new File(base, "SME/Respaldos");
                File[] files = directory == null ? null : directory.listFiles((dir, name) -> name.startsWith(prefix) && name.endsWith(".db"));
                if (files == null) return;
                java.util.Arrays.sort(files, (a, b) -> b.getName().compareTo(a.getName()));
                for (int i = keep; i < files.length; i++) if (!files[i].delete()) android.util.Log.w("SMEBackup", "No se pudo eliminar respaldo antiguo: " + files[i].getName());
            }
        } catch (Exception error) {
            android.util.Log.e("SMEBackup", "No se pudo aplicar la retención de respaldos " + prefix, error);
        }
    }
}
